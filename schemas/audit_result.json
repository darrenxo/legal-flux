{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_coverage",
    "rule_fit",
    "factual_grounding",
    "defense_coverage",
    "burden_correctness",
    "final_decision_consistency",
    "first_error",
    "downstream_symptoms",
    "rationale"
  ],
  "properties": {
    "issue_coverage": {"type": "integer", "minimum": 0, "maximum": 4},
    "rule_fit": {"type": "integer", "minimum": 0, "maximum": 4},
    "factual_grounding": {"type": "integer", "minimum": 0, "maximum": 4},
    "defense_coverage": {"type": "integer", "minimum": 0, "maximum": 4},
    "burden_correctness": {"type": "integer", "minimum": 0, "maximum": 4},
    "final_decision_consistency": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "first_error": {
      "type": "string",
      "enum": [
        "none",
        "input_insufficiency_or_leakage",
        "case_representation",
        "rule_or_authority",
        "fact_to_element_application",
        "burden_defense_or_counterargument",
        "issue_composition_or_final_judgment"
      ]
    },
    "downstream_symptoms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "rationale": {"type": "string"}
  }
}

