{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalOperatorIssueGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_analysis", "root_claim", "issues"],
  "properties": {
    "graph_analysis": {"type": "string", "maxLength": 1200},
    "root_claim": {"type": "string"},
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "parent_id",
          "issue_type",
          "issue_question",
          "party_positions",
          "fact_ids",
          "authority_ids"
        ],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^I[1-4]$"},
          "parent_id": {"type": "string", "pattern": "^(ROOT|I[1-4])$"},
          "issue_type": {
            "type": "string",
            "enum": [
              "procedural_gate",
              "claim_elements",
              "legal_interpretation",
              "authority",
              "evidence",
              "defense",
              "causation",
              "loss_quantum",
              "discretion",
              "appellate_review",
              "remedy"
            ]
          },
          "issue_question": {"type": "string", "minLength": 1, "maxLength": 600},
          "party_positions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["party", "position"],
              "properties": {
                "party": {"type": "string", "maxLength": 200},
                "position": {"type": "string", "maxLength": 500}
              }
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^F[0-9]+$"},
            "uniqueItems": true
          },
          "authority_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^A[0-9]+$"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
