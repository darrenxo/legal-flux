{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalFluxAbstractPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planning_analysis", "planned_steps"],
  "properties": {
    "planning_analysis": {"type": "string"},
    "planned_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "step_name", "step_description", "template_tags"],
        "properties": {
          "step_id": {"type": "string"},
          "step_name": {"type": "string"},
          "step_description": {"type": "string"},
          "template_tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
