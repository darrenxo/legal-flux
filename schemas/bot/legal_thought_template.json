{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalThoughtTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "name",
    "description",
    "applicability_cues",
    "reasoning_steps",
    "required_checks",
    "contraindications",
    "provenance_case_ids",
    "version"
  ],
  "properties": {
    "template_id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "applicability_cues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reasoning_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_checks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "contraindications": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance_case_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {"type": "integer", "minimum": 1}
  }
}
