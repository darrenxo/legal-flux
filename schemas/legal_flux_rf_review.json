{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalFluxRfReview",
  "oneOf": [
    {
      "title": "ContinueReview",
      "type": "object",
      "additionalProperties": false,
      "required": ["review_analysis", "decision"],
      "properties": {
        "review_analysis": {"type": "string"},
        "decision": {"type": "string", "const": "continue"}
      }
    },
    {
      "title": "ReviseReview",
      "type": "object",
      "additionalProperties": false,
      "required": ["review_analysis", "decision", "revised_remaining_steps"],
      "properties": {
        "review_analysis": {"type": "string"},
        "decision": {"type": "string", "const": "revise"},
        "revised_remaining_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_name", "step_description", "template_tags"],
            "properties": {
              "step_name": {"type": "string", "minLength": 1},
              "step_description": {"type": "string", "minLength": 1},
              "template_tags": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "title": "FinalAnswerReview",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_analysis",
        "decision",
        "final_rationale",
        "final_decision"
      ],
      "properties": {
        "review_analysis": {"type": "string"},
        "decision": {"type": "string", "const": "final_answer"},
        "final_rationale": {"type": "string"},
        "final_decision": {
          "type": "string",
          "enum": ["support", "reject"]
        }
      }
    }
  ]
}
